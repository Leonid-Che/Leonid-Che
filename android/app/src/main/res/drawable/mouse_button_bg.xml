<?xml version="1.0" encoding="utf-8"?>
<!-- Фон экранных кнопок мыши (ЛКМ / ЛКМ×2 / ПКМ) с состояниями нажатия:
     - обычное состояние: тёмный фон button_idle + рамка;
     - нажатие пальцем ИЛИ подсветка из кода (setPressed(true) при нажатии
       Громкость+/Громкость−): акцентный цвет button_lit.
     Оба состояния — один и тот же drawable, поэтому подсветка физическими
     клавишами выглядит точно так же, как нажатие кнопки пальцем. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_lit" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#546E7A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_idle" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#546E7A" />
        </shape>
    </item>
</selector>
