<?xml version="1.0" encoding="utf-8"?>
<!-- Фон экранных кнопок мыши (ЛКМ / ЛКМ×2 / ПКМ).
     Цвет фона управляется из кода: setBackgroundColor(button_lit/button_idle),
     рамка и скругления остаются поверх цвета. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="6dp" />
    <stroke android:width="1dp" android:color="#546E7A" />
</shape>
