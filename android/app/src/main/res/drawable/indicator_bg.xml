<?xml version="1.0" encoding="utf-8"?>
<!-- Совместимость со старыми сборками: отдельные индикаторы ЛКМ/ПКМ удалены
     (коммит 290884c), подсветку теперь даёт mouse_button_bg.xml. Файл оставлен
     как заглушка на случай, если локальный AAPT/Gradle-кэш или неполная
     загрузка проекта всё ещё ссылается на @drawable/indicator_bg.
     Цвета indicator_base / indicator_lit определены в colors.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/indicator_base" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#546E7A" />
        </shape>
    </item>
</layer-list>
