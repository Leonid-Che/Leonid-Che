<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg_dark">#0F141A</color>
    <color name="accent_green">#2E7D32</color>
    <color name="gray_button">#424242</color>
    <color name="text_light">#ECEFF1</color>
    <color name="text_dim">#90A4AE</color>
    <!-- Индикация нажатия экранных кнопок мыши: базовый и подсвеченный цвета.
         При нажатии Громкость+/Громкость− кнопки ЛКМ/ЛКМ×2/ПКМ подсвечиваются
         тем же цветом, что и при обычном нажатие пальцем. -->
    <color name="button_idle">#37474F</color>
    <color name="button_lit">#4CAF50</color>

    <!-- Совместимость: старые сборки/AAPT-кэши могут ещё ссылаться на
         drawable indicator_bg.xml и цвета indicator_* (отдельные индикаторы
         ЛКМ/ПКМ удалены в коммите 290884c). Оставлены как алиасы тех же
         цветов, чтобы сборка не падала с "resource color/indicator_base
         not found". -->
    <color name="indicator_base">#37474F</color>
    <color name="indicator_lit">#4CAF50</color>
</resources>
